    },
    {
      "id": "fine",
      "name": "Denda −3",
      "icon": "−3",
      "color": "#F05696",
      "kind": "trap",
      "desc": "Kurangi 3 poin dari skor Anda. Skor minimal 0."
    },
    {
      "id": "gift",
      "name": "Copet Baik",
      "icon": "⇄",
      "color": "#F05696",
      "kind": "trap",
      "desc": "Berikan hingga 2 poin Anda kepada pemain dengan skor terendah. Jika seri, pilih salah satu."
    },
    {
      "id": "back4",
      "name": "Terpental",
      "icon": "−4",
      "color": "#FF8040",
      "kind": "trap",
      "desc": "Mundurkan bidak 4 petak dengan tombol <, minimal sampai 0. Jangan jalankan efek di tujuan perpindahan ini."
    },
    {
      "id": "steal",
      "name": "Rampasan",
      "icon": "♠",
      "color": "#32B18E",
      "kind": "lucky",
      "desc": "Curi hingga 2 poin dari satu lawan pilihan Anda. Catat di meja."
    },
    {
      "id": "swap",
      "name": "Tukar Kartu",
      "icon": "↔",
      "color": "#3CB4E6",
      "kind": "lucky",
      "desc": "Pilih satu lawan. Masing-masing menyerahkan satu kartu pilihan sendiri secara tertutup, lalu tukar."
    },
    {
      "id": "tax",
      "name": "Pajak Meja",
      "icon": "−1",
      "color": "#F05696",
      "kind": "trap",
      "desc": "Semua pemain, termasuk Anda, kehilangan 1 poin. Skor minimal 0."
    },
    {
      "id": "shield",
      "name": "Perisai",
      "icon": "◇",
      "color": "#32B18E",
      "kind": "lucky",
      "desc": "Ambil satu penanda perisai fisik. Sekali pakai untuk membatalkan trap atau serangan terhadap diri sendiri. Maksimal simpan satu."
    },
    {
      "id": "duel",
      "name": "Duel Remi",
      "icon": "⚔",
      "color": "#9C208C",
      "kind": "event",
      "desc": "Pilih lawan. Masing-masing ambil satu kartu dari tumpukan: A=1 sampai K=13, Joker=14. Angka lebih tinggi mendapat 3 poin; seri tidak ada bonus. Buang kedua kartu."
    },
    {
      "id": "finish",
      "name": "Finis",
      "icon": "★",
      "color": "#3CB4E6",
      "kind": "finish",
      "desc": "Perjalanan selesai! Pemain yang membawa bidak ke sini mendapat 3 poin. Bandingkan skor di meja; skor tertinggi menang, skor seri berarti menang bersama."
    }
  ],
  "roles": [
    {
      "id": "duke",
      "name": "Duke",
      "icon": "♛",
      "color": "#FFD730",
      "desc": "2 kali per permainan: tambah 2 poin ketika mengambil petak poin. Maksimal satu skill role per giliran."
    },
    {
      "id": "assassin",
      "name": "Assassin",
      "icon": "⚔",
      "color": "#F05696",
      "desc": "2 kali per permainan: kurangi skor satu lawan sebesar 3. Dapat dibatalkan Contessa atau perisai. Skor minimal 0."
    },
    {
      "id": "captain",
      "name": "Captain",
      "icon": "♠",
      "color": "#3CB4E6",
      "desc": "2 kali per permainan: curi hingga 2 poin dari satu lawan. Dapat dibatalkan Contessa atau perisai."
    },
    {
      "id": "ambassador",
      "name": "Ambassador",
      "icon": "↔",
      "color": "#32B18E",
      "desc": "2 kali per permainan: buang hingga 2 kartu tangan, lalu ambil pengganti dari tumpukan."
    },
    {
      "id": "contessa",
      "name": "Contessa",
      "icon": "◇",
      "color": "#9C208C",
      "desc": "2 kali per permainan: batalkan satu trap atau serangan terhadap diri sendiri. Gunakan saat efek diumumkan."
    }
  ],
  "cards": [
    {
      "id": "numbers",
      "name": "A–9 · Langkah",
      "icon": "A",
      "color": "#3CB4E6",
      "desc": "Maju sesuai angka. A = 1. Mainkan satu kartu fisik, lalu gerakkan bidak dengan tombol >. Kartu 8 dan 9 tetap langkah besar."
    },
    {
      "id": "tenred",
      "name": "10 merah ♥ ♦ · Lucky Jump",
      "icon": "♥",
      "color": "#F05696",
      "desc": "Pindah ke petak Lucky berikutnya di depan (jenis poin atau lucky), yang belum terpakai. Aktifkan efeknya. Jika tidak ada, maju 1. Untuk map Misteri, buka petak berurutan hingga Lucky pertama ditemukan."
    },
    {
      "id": "tenblack",
      "name": "10 hitam ♠ ♣ · Pasang Trap",
      "icon": "♠",
      "color": "#001F4F",
      "desc": "Ubah satu petak kosong dalam 10 petak di depan bidak menjadi trap pilihan dari katalog. Jangan gunakan finis. Lalu maju 1. Jika tidak ada yang kosong, cukup maju 1."
    },
    {
      "id": "jack",
      "name": "J · Putar Balik",
      "icon": "J",
      "color": "#FF8040",
      "desc": "Mundur 1–6 petak pilihan Anda, minimal sampai 0. Jalankan efek petak tujuan, kecuali posisi 0."
    },
    {
      "id": "queen",
      "name": "Q · Pelindung",
      "icon": "Q",
      "color": "#32B18E",
      "desc": "Maju 1–6 petak pilihan Anda. Abaikan trap pada giliran ini."
    },
    {
      "id": "king",
      "name": "K · Perampas",
      "icon": "K",
      "color": "#B89C57",
      "desc": "Maju 1–6 petak pilihan Anda. Jika mendapat poin dari petak tujuan, curi tambahan hingga 2 poin dari satu lawan."
    },
    {
      "id": "joker",
      "name": "Joker · Tukar Nasib",
      "icon": "✦",
      "color": "#9C208C",
      "desc": "Tukar isi dua petak yang belum terpakai. Jangan pilih petak bidak atau finis. Gunakan pilihan petak pada panel, lalu maju 1–6 petak."
    }
  ],
